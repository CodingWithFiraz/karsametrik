# ================================================================
# NexaUMKM — Environment Configuration
# ================================================================
# Salin file ini dan isi nilainya sesuai environment kamu.
# JANGAN commit file .env yang sudah berisi nilai asli ke Git!
# ================================================================

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=nexaumkm
DB_USER=root
DB_PASS=
DB_CHARSET=utf8mb4

# ── App Settings ─────────────────────────────────────────────────
# production | development
APP_ENV= production
APP_DEBUG=false

# ── CORS ─────────────────────────────────────────────────────────
# URL frontend kamu (tanpa trailing slash)
CORS_ORIGIN= *

# ── JWT Authentication ───────────────────────────────────────────
# Ganti dengan string acak yang panjang dan aman (min. 32 karakter)
JWT_SECRET=YOUR_RANDOM_JWT_SECRET_KEY_HERE
# Durasi token dalam detik (default: 28800 = 8 jam)
JWT_EXPIRE=28800

# ── Pagination ───────────────────────────────────────────────────
PAGE_LIMIT_DEFAULT=15
PAGE_LIMIT_MAX=100


N8N_WEBHOOK_URL=http://localhost:5678/webhook/submit-sisehat
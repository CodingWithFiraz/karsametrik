
{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "outputDirectory": "html",
  "functions": {
    "api/index.php": {
      "runtime": "vercel-php@0.7.0"
    }
  },
  "rewrites": [
    {
      "source": "/backend/api.php",
      "destination": "/api/index.php"
    },
    {
      "source": "/api.php",
      "destination": "/api/index.php"
    }
  ]
}
